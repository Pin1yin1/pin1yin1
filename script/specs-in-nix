#!/usr/bin/env bash
set -euo pipefail

db_dir=$(mktemp -d /tmp/pin1yin1-specs.XXXXXXXX)
db_pid=

cleanup() {
  if [[ -n "$db_pid" ]]; then
    kill "$db_pid" 2>/dev/null || true
    wait "$db_pid" 2>/dev/null || true
  fi
  rm -rf -- "$db_dir"
}
trap cleanup EXIT

mariadb-install-db --datadir="$db_dir/data" --auth-root-authentication-method=normal --skip-test-db > "$db_dir/install.log" 2>&1
mariadbd --datadir="$db_dir/data" --socket="$db_dir/mysql.sock" --pid-file="$db_dir/mysql.pid" --skip-networking --log-error="$db_dir/server.log" --character-set-server=utf8mb4 &
db_pid=$!

for attempt in {1..120}; do
  if mariadb-admin --socket="$db_dir/mysql.sock" -u root ping > /dev/null 2>&1; then
    break
  fi
  if ! kill -0 "$db_pid" 2>/dev/null; then
    cat "$db_dir/server.log" >&2
    exit 1
  fi
  sleep 0.25
done

if ! mariadb-admin --socket="$db_dir/mysql.sock" -u root ping > /dev/null 2>&1; then
  cat "$db_dir/server.log" >&2
  exit 1
fi

mariadb --socket="$db_dir/mysql.sock" -u root -e 'CREATE DATABASE pin1yin1_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci'
export MYSQL_UNIX_PORT="$db_dir/mysql.sock"
export PIN1YIN1_TEST_USERNAME=root
export RAILS_ENV=test

bundle exec rake db:schema:load
bundle exec rake spec
